DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.region.neon.tech/neondb
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
APP_NAME=Resort Admin API
ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY_MINUTES=480
ADMIN_EMAIL=you@yourresort.com
ADMIN_PASSWORD=use-a-strong-password-at-least-8-chars
RATE_LIMIT_WRITES=30
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH_FAILURES=10
RATE_LIMIT_GLOBAL_AUTH_FAILURES=50
MAX_BODY_BYTES=1000000
SEED_ENABLED=false
